# Токен бота от @BotFather. Используйте ОТДЕЛЬНЫЙ токен, не тот, что у отладочного бота
BOT_TOKEN=token
# HTTPS-адрес мини-апки
WEBAPP_URL=https://test/ru
# Адрес вашего бэкенда на winow (из контейнера localhost не подойдёт)
BACKEND_URL=https://www.test/test
# Когда слать напоминания: часовой пояс и час (0-23)
REMINDER_TZ=Europe/Moscow
REMINDER_HOUR=10
